# Every public type and member of the library must have an XML doc comment. CS1591 (missing XML comment) is a warning
# for all C# files here, and the build uses -warnaserror, so an undocumented public member fails the build.
# The generated files in Generated/ are covered too: their members are overrides or partial declarations documented in the source.

[*.cs]
dotnet_diagnostic.CS1591.severity = warning
